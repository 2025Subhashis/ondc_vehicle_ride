# --- Build Stage ---
FROM rust:latest-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Copy the entire workspace to the build context
COPY . .

# Build the pricing-engine specifically
RUN rm -rf /usr/local/cargo/registry/index && cargo update && cargo build --release -p pricing-engine

# --- Run Stage ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Copy the binary from the build stage
COPY --from=builder /app/target/release/pricing-engine /app/pricing-engine

EXPOSE 8081

CMD ["./pricing-engine"]
